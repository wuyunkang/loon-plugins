#!name=红果短剧去广告
#!desc=拦截红果短剧广告接口和连播广告视频节点。金币任务和福利奖励将不可用。
#!date=2026-11-11
#!author=Codex
#!tag=去广告,红果短剧
#!loon_version=3.5.1(978)

[Rule]
# 红果/番茄业务中明确标记为广告或广告日志的独立域名。
DOMAIN,ads3-normal-hl.zijieapi.com,REJECT
DOMAIN,ads3-normal-lf.zijieapi.com,REJECT
DOMAIN,ads3-normal-lq.zijieapi.com,REJECT
DOMAIN,ads3-normal.zijieapi.com,REJECT
DOMAIN,ads5-normal-hl.zijieapi.com,REJECT
DOMAIN,ads5-normal-lf.zijieapi.com,REJECT
DOMAIN,ads5-normal-lq.zijieapi.com,REJECT
DOMAIN,ads5-normal.zijieapi.com,REJECT
DOMAIN,log3-applog-hl.fqnovel.com,REJECT
DOMAIN,log3-applog.fqnovel.com,REJECT
DOMAIN,log5-applog-hl.fqnovel.com,REJECT
DOMAIN,log5-applog.fqnovel.com,REJECT
DOMAIN,rtlog3-applog-hl.fqnovel.com,REJECT
DOMAIN,rtlog3-applog.fqnovel.com,REJECT
DOMAIN,rtlog5-applog-hl.fqnovel.com,REJECT
DOMAIN,rtlog5-applog.fqnovel.com,REJECT

# 连播广告视频，与正片共用 qznovelvod.com，只列广告素材主机。
DOMAIN,v5-reading-ad.qznovelvod.com,REJECT
DOMAIN,v5-bd-daily-reading-ad.qznovelvod.com,REJECT
DOMAIN,v5-se-sjy-daily-reading-ad.qznovelvod.com,REJECT
DOMAIN,v6-reading-ad.qznovelvod.com,REJECT
DOMAIN,v9-reading-ad.qznovelvod.com,REJECT
DOMAIN,v11-reading-ad.qznovelvod.com,REJECT
DOMAIN,v13-reading-ad.qznovelvod.com,REJECT
DOMAIN,v26-reading-ad.qznovelvod.com,REJECT
DOMAIN,v96-reading-ad.qznovelvod.com,REJECT

# 字节跳动广告图片签名域名。仅拦截 ad-sign 子域，不影响通用 byteimg 图片。
DOMAIN,p3-ad-sign.byteimg.com,REJECT
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT

# 穿山甲/Gromore 广告请求、广告落地页和广告素材统计域名。
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangolin-dsp-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-dsp-toutiao-b.com,REJECT
DOMAIN-SUFFIX,panplayable-toutiao.com,REJECT
DOMAIN-SUFFIX,panplayable-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-snssdk-toutiao.com,REJECT
DOMAIN,pangolin.snssdk.com,REJECT
DOMAIN,pangolin-hl.snssdk.com,REJECT
DOMAIN,pangolin-lf.snssdk.com,REJECT
DOMAIN,pangolin-lq.snssdk.com,REJECT
DOMAIN,sf3-ttcdn-tos.pstatp.com,REJECT

# 红果中可能加载的其他广告联盟域名，仅使用明确的广告服务域名。
DOMAIN,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,byteadverts.com,REJECT
DOMAIN,dig.bdurl.net,REJECT
DOMAIN,api.iegadp.qq.com,REJECT
DOMAIN,adim.pinduoduo.com,REJECT
DOMAIN-SUFFIX,shoppingads.cn,REJECT

# 金币福利独立域名。
DOMAIN-SUFFIX,luckycat.byteug.com,REJECT

[Rewrite]
# 同一组红果 API 主机也提供常规接口，只拦金币路径。
^https?://api[35]-normal(?:-hl)?\.fqnovel\.com/luckycat/ reject

[MITM]
# URL Rewrite 需要解密 HTTPS；仅限红果 API 主机，视频 CDN 不在此列表中。
hostname = api3-normal.fqnovel.com,api3-normal-hl.fqnovel.com,api5-normal.fqnovel.com,api5-normal-hl.fqnovel.com

