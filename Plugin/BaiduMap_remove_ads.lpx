#!name=百度地图去广告·诊断 2026-11-17 14:49
#!desc=诊断版本 2026-11-17 14:49（北京时间）。首页使用可见文字探针，两个接口附版本响应头，取消条件缓存。请只启用本版后重新抓首页和我的页。
#!date=2026-11-17 14:49
#!author=Codex
#!tag=去广告,百度地图
#!loon_version=3.5.1(978)

[Rule]
# 百度广告平台及抓包中出现的广告 SDK 主机，只使用精确域名。
DOMAIN,afd.baidu.com,REJECT
DOMAIN,afdconf.baidu.com,REJECT
DOMAIN,api.yunxish.com,REJECT
DOMAIN,cdn.yunxish.com,REJECT
DOMAIN,cpc-service-square.yunxish.com,REJECT
DOMAIN,cpc-service-square.iggrowth.cn,REJECT
DOMAIN,sdkquic.e.qq.com,REJECT
DOMAIN,oss.cdn.aiclk.com,REJECT
DOMAIN,rcv.aiclk.com,REJECT

[Rewrite]
# 开屏广告。ads 响应可能是二进制协议，返回空响应，不伪造 JSON。
^https?://newclient\.map\.baidu\.com(?::\d+)?/client/phpui2/?\?(?:[^&#]*&)*qt=ads(?:&[^#]*)?$ reject-200

# 首页左上角横幅；完整匹配 qt，兼容参数顺序变化。
^https?://newclient\.map\.baidu\.com(?::\d+)?/client/phpui2/?\?(?:[^&#]*&)*qt=bar(?:&[^#]*)?$ reject-200

# 搜索推广接口，保留其他 qt 查询。
^https?://newclient\.map\.baidu\.com(?::\d+)?/client/phpui2?/?\?(?:[^&#]*&)*qt=hw(?:&[^#]*)?$ reject-200

# 首页推广通知横条。
^https?://newclient\.map\.baidu\.com(?::\d+)?/client/noticebar/get/?(?:\?[^#]*)?$ reject-200

# 商业推广下发。只匹配接口本身，不扩展到未知子路径。
^https?://newclient\.map\.baidu\.com(?::\d+)?/client/crossmarketing/?(?:\?[^#]*)?$ reject-200

# 首页周边的独立广告接口，保留 POI 推荐和正文信息流接口。
^https?://newclient\.map\.baidu\.com(?::\d+)?/feed-server/nearby/ads/?(?:\?[^#]*)?$ reject-200

# 已知广告素材目录。共享 CDN 的其他图片、地图素材保持放行。
^https?://dss0\.bdstatic\.com(?::\d+)?/[^?#]+/tam-ogel/[^?#]+\.(?:jpg|mp4)(?:\?[^#]*)?$ reject

# 新版开屏：HTTP 200 且业务成功时，通过内置 JQ 清空确认的广告列表。
response if ${url} ~= /^https?:\/\/ecom\.map\.baidu\.com(?::\d+)?\/ad-ops\/afd\/(?:entry|material_async)\/?(?:\?[^#]*)?$/i && ${response.status} == 200 then response.json.jq("if type == \"object\" then if .code == 0 and (.result | type) == \"object\" then if (.result.ad_info | type) == \"array\" then .result.ad_info = [] else . end else . end else . end")

# 首页底部：from=homepage 使用可见文字探针和一个默认分类，用于诊断实际响应与渲染。
response if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com(?::\d+)?\/feed\/govui\/rich_content\/?\?(?:[^&#]*&)*from=homepage(?:&[^#]*)?$/i && ${response.status} == 200 then response.json.jq("if type == \"object\" then if .errno == 0 and (.data | type) == \"object\" then (if (.data.posts | type) == \"object\" then if (.data.posts.content | type) == \"array\" then .data.posts.content = [{\"content_type\":\"feed_dynamic_card_new\",\"content_type_modify\":\"fullline\",\"cover\":\"\\u200b\",\"dynamicBoxStyle\":{\"background-color\":\"null\",\"padding-bottom\":\"6\",\"padding-top\":\"30\"},\"components\":[{\"componentType\":\"img-text\",\"data\":{\"text\":\"百度地图\",\"textLineClamp\":1,\"colorDark\":\"#d3d9e6\",\"iconUrl\":\"\",\"darkIconUrl\":\"\",\"iconStyle\":{\"height\":\"0\",\"width\":\"0\",\"margin-left\":\"0\",\"margin-right\":\"0\",\"opacity\":0.18,\"filter\":\"grayscale(1)\"},\"imgTextStyle\":{\"flex\":1,\"justify-content\":\"center\",\"align-items\":\"center\"},\"textStyle\":{\"color\":\"#9aa3b2\",\"font-family\":\"PingFang SC\",\"font-size\":15,\"font-weight\":400,\"letter-spacing\":\"0%\",\"margin-bottom\":0,\"text-align\":\"center\"}}}]}] | (if (.data.posts.remain_num | type) == \"number\" then .data.posts.remain_num = 0 else . end) | (if (.data.posts.title | type) == \"string\" then .data.posts.title = \"\" else . end) else . end else . end) | (if (.data.themes | type) == \"object\" then if (.data.themes.content | type) == \"array\" then (.data.themes.content | map(select(type == \"object\")) | (map(select(.selected == true)) + .) | .[0]) as $theme | .data.themes.content = [(($theme // {}) | .name = \"\\u200b\" | .icon = \"\" | .nameIcon = \"\" | .nameIconDark = \"\" | .labels = [] | .selected = true | (if (.query | type) == \"object\" then . else .query = {\"rqt\":\"\",\"topic\":\"default\"} end))] | (if (.data.themes.themeShow | type) == \"boolean\" then .data.themes.themeShow = false else . end) | (if (.data.themes.iconExist | type) == \"boolean\" then .data.themes.iconExist = false else . end) | (if (.data.themes.labelStyle | type) == \"boolean\" then .data.themes.labelStyle = false else . end) else . end else . end) else . end else . end")

# 其他来源的信息流只移除广告卡，保留周边等页面的正常内容。
response if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com(?::\d+)?\/feed\/govui\/rich_content\/?(?:\?(?!(?:[^&#]*&)*from=homepage(?:&|$))[^#]*)?$/i && ${response.status} == 200 then response.json.jq("if type == \"object\" then if .errno == 0 and (.data | type) == \"object\" then if (.data.posts | type) == \"object\" then if (.data.posts.content | type) == \"array\" then .data.posts.content |= map(if type == \"object\" then select(.content_type != \"feed_fengchao_ad_card\") else . end) else . end else . end else . end else . end")

# 我的页：业务成功码为 2000。移除金币金融店铺数据，百度运动返回空对象以显式覆盖旧值。
response if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com(?::\d+)?\/usercenter\/mine\/page\/?(?:\?[^#]*)?$/i && ${response.status} == 200 then response.json.jq("if type == \"object\" then if .error == 2000 and (.data | type) == \"object\" then del(.data.gold, .data.gold_coin_card, .data.finance, .data.shop) | (if (.data.sport_card | type) == \"object\" then .data.sport_card = {} else . end) | (if (.data.card_list | type) == \"array\" then .data.card_list |= map(select(. != \"gold\")) else . end) | (if (.data.corner_marks | type) == \"object\" then del(.data.corner_marks.dxm, .data.corner_marks.shop) else . end) else . end else . end")

# 临时诊断：只向 App 返回固定版本标记，不记录请求正文、账号、设备或坐标。
request if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com(?::\d+)?\/(?:feed\/govui\/rich_content|usercenter\/mine\/page)\/?(?:\?[^#]*)?$/i then request.header.del("If-None-Match") | request.header.del("If-Modified-Since") | request.header.set("Cache-Control", "no-cache")
response if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com(?::\d+)?\/feed\/govui\/rich_content\/?(?:\?[^#]*)?$/i then response.header.set("X-BMap-Diag-Version", "20261117-1449") | response.header.set("X-BMap-Diag-Target", "rich-content") | response.header.set("Cache-Control", "no-store")
response if ${url} ~= /^https?:\/\/newclient\.map\.baidu\.com(?::\d+)?\/usercenter\/mine\/page\/?(?:\?[^#]*)?$/i then response.header.set("X-BMap-Diag-Version", "20261117-1449") | response.header.set("X-BMap-Diag-Target", "mine-page") | response.header.set("Cache-Control", "no-store")
# 版本响应头只证明诊断规则匹配，不代表 JQ 成功或界面已经改变。

[MITM]
hostname = newclient.map.baidu.com,ecom.map.baidu.com,dss0.bdstatic.com
